# All config is normally written to ./chance.config.json by `bun run setup`.
# These envs are only consulted as fallbacks if the config file is missing a value.

# Coin Communities
CC_BASE_URL=https://api.coin-communities.xyz
CC_API_KEY=
CC_SERVER_KEY=
CC_SERVER_SECRET=
CC_TWITTER_ID=          # numeric Twitter ID of Chance's persona

# LLM (whichever you picked)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
